<!DOCTYPE html>
<html>
  <head>
    <title>Select Student</title>
    <%- include("../partials/head") %>
    
    <script>
      let allRows = [];

      function initStudentTable() {
        // Save all rows into JS array
        allRows = Array.from(
          document.querySelectorAll("#studentTable tbody tr")
        );

        // Show only first 20
        allRows.forEach((row, i) => {
          row.style.display = i < 20 ? "" : "none";
        });
      }

      function searchStudents() {
        const query = document
          .getElementById("searchInput")
          .value.toLowerCase();
        let shown = 0;

        allRows.forEach((row) => {
          const match = row.innerText.toLowerCase().includes(query);
          row.style.display = match && shown < 20 ? "" : "none";
          if (match) shown++;
        });
      }

      function toggleStudentSection() {
        const section = document.getElementById("studentSection");
        section.style.display =
          section.style.display === "none" ? "block" : "none";
        if (section.style.display === "block") initStudentTable();
      }
    </script>
  </head>

  <body class="p-4">
    <%- include('../partials/sidebar') %>
    <div class="dashboard-main-wrapper">
      <div
        class="top-navbar flex-between gap-16"
        style="background-color: rgb(254, 254, 254)"
      >
        <div class="flex-align gap-16">
          <!-- Toggle Button Start -->
          <button
            type="button"
            class="toggle-btn d-xl-none d-flex text-26 text-gray-500"
          >
            <i class="ph ph-list"></i>
          </button>
          <!-- Toggle Button End -->

          <h1>Student Certificate</h1>
        </div>

        <div class="flex-align gap-16">
          <a
            href="/admin/logout"
            class="py-12 text-15 px-20 hover-bg-danger-50 text-gray-300 hover-text-danger-600 rounded-8 flex-align gap-8 fw-medium text-15"
          >
            <span class="text-2xl text-danger-600 d-flex"
              ><i class="ph ph-sign-out"></i
            ></span>
            <span class="text">Log Out</span>
          </a>
        </div>
      </div>
      <!-- Body Content Starts here  -->

      <!-- Toggle Button -->
      <div class="button-content" style="text-align: center; width: 100%">
        <button
          onclick="toggleStudentSection()"
          class="btn btn-primary mb-3"
          style="width: 400px; margin: 1rem; text-align: center"
        >
          Toggle Student Selection
        </button>
      </div>
      <!-- STUDENT SEARCH & SELECT (toggleable section) -->
      <div id="studentSection" style="display: none">
        <input
          type="text"
          id="searchInput"
          onkeyup="searchStudents()"
          placeholder="Search student..."
          class="form-control mb-3"
        />

        <table class="table table-bordered" id="studentTable">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Course</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach(student => { %>
            <tr>
              <td><%= student.name %></td>
              <td><%= student.email %></td>
              <td><%= student.course.name %></td>
              <td>
                <a
                  href="/admin/marks/form/<%= student._id %>"
                  class="btn btn-outline-primary btn-sm"
                >
                  Open Form
                </a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>

        <hr class="my-5" />
      </div>

      <!-- CERTIFICATE LIST -->
      <h3>Students with Certificates</h3>
      <!-- Table Container -->
      <div class="table-responsive p-3">
        <table class="table table-bordered table-hover shadow-sm rounded">
          <thead class="table-primary text-center">
            <tr>
              <th>Name</th>
              <th>Course</th>
              <th>Certificate No.</th>
              <th>Issue Date</th>
              <th>Certificate</th>
              <th>Marksheet</th>
            </tr>
          </thead>
          <tbody class="align-middle text-center">
            <% issuedStudents.forEach(entry => { %>
            <tr>
              <td><%= entry.student.name %></td>
              <td><%= entry.student.course.name %></td>
              <td><%= entry.certificateNo %></td>
              <td><%= new Date(entry.issueDate).toLocaleDateString() %></td>
              <td>
                <a
                  href="/admin/marks/certificate/<%= entry._id %>"
                  target="_blank"
                  class="btn btn-success btn-sm"
                >
                  View Certificate
                </a>
              </td>
              <td>
                <a
                  href="/admin/marks/marksheet/<%= entry._id %>"
                  target="_blank"
                  class="btn btn-info btn-sm"
                >
                  View Marksheet
                </a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <script>
        // Run table limit only when page is loaded
        window.addEventListener("DOMContentLoaded", () => {
          const section = document.getElementById("studentSection");
          if (section.style.display === "block") initStudentTable();
        });
      </script>
    </div>
  </body>
</html>
